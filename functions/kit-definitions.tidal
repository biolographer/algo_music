
-- using the numbered samples as a "kit"
-- e.g. bd:1 sd:1 hh:1 are a kit
let bd pat = struct pat $ s "bd" # n (fromIntegral <$> cI 0 "kit")
    sd pat = struct pat $ s "sd" # n (fromIntegral <$> cI 0 "kit")
    hh pat = struct pat $ s "hh" # n (fromIntegral <$> cI 0 "kit")

setI "kit" 1

d1 $ stack [
    bd "t(3,8)",
    sd "~ t",
    hh "t*8"
  ]

-- using foldernames as the kit
-- e.g. 808bd is an 808 bassdrum
let bd pat = struct pat $ s (fmap (++ "bd") (cS "808" "kit"))
    sd pat = struct pat $ s (fmap (++ "sd") (cS "808" "kit"))
    cp pat = struct pat $ s (fmap (++ "cp") (cS "808" "kit"))
    hh pat = struct pat $ s (fmap (++ "hh") (cS "808" "kit"))
    cy pat = struct pat $ s (fmap (++ "cy") (cS "808" "kit"))
    setKit kit = setS "kit" kit

-- Initialize the kit string
setS "kit" "808"

d1 $ stack [
    -- Pick a random sample from 0 to 4 for every kick
    bd "t(3,8)" # n (irand 5),
    -- Alternate between sample 0 and 2 for the snare
    jux rev $ sd "~ t" # n "0 2",
    -- Randomly choose from samples 0, 1, 2, or 3 for the hats
    hh "t*8" # n (choose [0..3])
  ]

   $ loopAt 3
   $ slice 24 (cat [
     "13 14 13 14 15 16 15 16", -- < pitch down second [13 14]
     "16 13 15 16 17 18 19 20",
     "13 14 15 16 16 16 15 16",
     "16 13 15 16 17 18 19 20" -- < more pitch downs

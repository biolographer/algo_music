8 Splash - Babylon

d1 $ fast 3
   $ loopAt 3
   $ slice 24 (cat [
     "13 14 15 15 15 13 14 15",
     "13 14 15 16 15 16 17 18",
     "13 14 15 15 15 13 14 15",
     "13 14 15 16 [15*16]@4"
     ]
   )
   $ s "breaks152"
   # gain 1.1
   |- gain "<0!3 [0 0 [0.2 0.19 0.18 0.17 0.16 0.15 0.14 0.13 0.12 0.11 0.1 0.09 0.08 0.07 0.06 0.05 0.04 0.03 0.02 0.01]@2]>"

9 Remarc - RIP


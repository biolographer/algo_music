#N canvas 600 200 500 300 12;
#X obj 50 20 inlet;
#X text 100 20 gate bang (on/off);
#X obj 50 50 select 1 0;
#X msg 50 80 127;
#X msg 100 80 0;
#X obj 50 110 outlet;
#X text 100 110 0 or 127;
#X text 50 200 Gate generator;
#X text 50 220 Input: 1 = note on 0 = note off;
#X text 50 240 Output: 127 (on) or 0 (off);
#X connect 0 0 2 0;
#X connect 2 0 3 0;
#X connect 2 1 4 0;
#X connect 3 0 5 0;
#X connect 4 0 5 0;

#N canvas 600 200 500 300 12;
#X obj 50 20 inlet;
#X text 100 20 gate bang (on/off);
#X obj 50 83 select 1 0;
#X msg 50 202 127;
#X msg 100 202 0;
#X obj 50 264 outlet;
#X text 100 264 0 or 127;
#X text 50 289 Gate generator;
#X text 50 309 Input: 1 = note on 0 = note off;
#X text 50 329 Output: 127 (on) or 0 (off);
#X connect 0 0 2 0;
#X connect 2 0 3 0;
#X connect 2 1 4 0;
#X connect 3 0 5 0;
#X connect 4 0 5 0;

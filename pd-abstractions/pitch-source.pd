#N canvas 600 200 700 600 12;
#X obj 50 20 inlet;
#X text 100 20 note number (MIDI pitch);
#X obj 300 20 inlet;
#X obj 50 100 / 12;
#X obj 300 100 * 5;
#X obj 50 140 + 0;
#X floatatom 118 180 4 0 2000 0 glide_ms - - 0;
#X obj 50 220 line;
#X obj 50 260 * 1638.3;
#X obj 50 300 outlet;
#X text 100 300 pitchbend -8192 to 8191;
#X text 50 360 1V/octave Pitch Source;
#X text 50 380 V = (note-60)/12 + (bend/8191.5)*5;
#X text 50 400 Middle C (60) + bend 0 = 0V;
#X text 50 420 1638.3 = 8191.5/5;
#X text 50 440 glide_ms sets portamento time (0 = instant);
#X text 350 20 known bug bendin is from 0 to 16383;
#X obj 300 60 / 16383;
#X text 350 99 buggy implementation \, nees to be fixed;
#X msg 128 120 0;
#X obj 137 65 loadbang;
#X obj 55 57 - 72;
#X text -152 56 Somehow Logic is an octave off;
#X connect 0 0 21 0;
#X connect 2 0 17 0;
#X connect 3 0 5 0;
#X connect 5 0 7 0;
#X connect 6 0 7 1;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 17 0 4 0;
#X connect 19 0 5 1;
#X connect 20 0 19 0;
#X connect 21 0 3 0;
